-- 01_schema.sql\
-- Course 4: Structured Databases | Module 2: Build the MySQL Foundation\
-- Project: future_portfolio_db (built from the Ananya Rao resume)\
--\
-- Builds the database and all 13 tables from the Module 1 ER diagram.\
-- Re-runnable: it DROPS the database first, so every run starts clean.\
-- Run this file first, then 02_seed_core.sql.\
--\
-- Deliberately left for Module 3 (Data Integrity and Normalization):\
-- NOT NULL, UNIQUE, DEFAULT, CHECK and referential actions\
-- (ON DELETE / ON UPDATE). Module 3 adds them with ALTER TABLE.\
--\
-- Target: MySQL 8.4 LTS, run in MySQL Workbench.\
-- =====================================================================\
\
-- WARNING: this deletes the whole database and everything in it.\
DROP DATABASE IF EXISTS future_portfolio_db;\
\
CREATE DATABASE future_portfolio_db\
    CHARACTER SET utf8mb4\
    COLLATE utf8mb4_0900_ai_ci;\
\
USE future_portfolio_db;\
\
-- ---------------------------------------------------------------------\
-- Parent tables first: they are referenced by other tables.\
-- ---------------------------------------------------------------------\
\
-- 1. people: the person the portfolio describes\
CREATE TABLE people (\
    person_id            INT AUTO_INCREMENT PRIMARY KEY,\
    full_name            VARCHAR(100),\
    headline             VARCHAR(150),\
    professional_summary TEXT,\
    location             VARCHAR(100),\
    email                VARCHAR(150)\
);\
\
-- 2. companies: every employer\
CREATE TABLE companies (\
    company_id   INT AUTO_INCREMENT PRIMARY KEY,\
    company_name VARCHAR(100),\
    description  TEXT\
);\
\
-- 3. employment: one row per period at a company\
--    (a person has many employment periods; a company has many too)\
CREATE TABLE employment (\
    employment_id INT AUTO_INCREMENT PRIMARY KEY,\
    person_id     INT,\
    company_id    INT,\
    start_date    DATE,\
    end_date      DATE,\
    summary       TEXT,\
    CONSTRAINT fk_employment_person\
        FOREIGN KEY (person_id) REFERENCES people (person_id),\
    CONSTRAINT fk_employment_company\
        FOREIGN KEY (company_id) REFERENCES companies (company_id)\
);\
\
-- 4. roles: one row per title held within an employment period\
CREATE TABLE roles (\
    role_id       INT AUTO_INCREMENT PRIMARY KEY,\
    employment_id INT,\
    role_title    VARCHAR(100),\
    start_date    DATE,\
    end_date      DATE,\
    team_size     INT,\
    summary       TEXT,\
    CONSTRAINT fk_roles_employment\
        FOREIGN KEY (employment_id) REFERENCES employment (employment_id)\
);\
\
-- 5. projects: named pieces of work (names agreed in Module 1)\
CREATE TABLE projects (\
    project_id   INT AUTO_INCREMENT PRIMARY KEY,\
    project_name VARCHAR(150),\
    description  TEXT\
);\
\
-- 6. role_projects: junction table, which role delivered which project\
CREATE TABLE role_projects (\
    role_id      INT,\
    project_id   INT,\
    contribution TEXT,\
    PRIMARY KEY (role_id, project_id),\
    CONSTRAINT fk_role_projects_role\
        FOREIGN KEY (role_id) REFERENCES roles (role_id),\
    CONSTRAINT fk_role_projects_project\
        FOREIGN KEY (project_id) REFERENCES projects (project_id)\
);\
\
-- 7. skills: the agreed skill list\
CREATE TABLE skills (\
    skill_id       INT AUTO_INCREMENT PRIMARY KEY,\
    skill_name     VARCHAR(100),\
    skill_category VARCHAR(50)\
);\
\
-- 8. project_skills: junction table, which project used which skill\
CREATE TABLE project_skills (\
    project_id INT,\
    skill_id   INT,\
    PRIMARY KEY (project_id, skill_id),\
    CONSTRAINT fk_project_skills_project\
        FOREIGN KEY (project_id) REFERENCES projects (project_id),\
    CONSTRAINT fk_project_skills_skill\
        FOREIGN KEY (skill_id) REFERENCES skills (skill_id)\
);\
\
-- 9. education: degree and executive programmes\
CREATE TABLE education (\
    education_id   INT AUTO_INCREMENT PRIMARY KEY,\
    person_id      INT,\
    qualification  VARCHAR(150),\
    institution    VARCHAR(150),\
    education_type VARCHAR(30),\
    start_year     YEAR,\
    end_year       YEAR,\
    CONSTRAINT fk_education_person\
        FOREIGN KEY (person_id) REFERENCES people (person_id)\
);\
\
-- 10. awards: one row per award-year\
--     company_id is filled only for awards given by an employer\
CREATE TABLE awards (\
    award_id       INT AUTO_INCREMENT PRIMARY KEY,\
    person_id      INT,\
    award_name     VARCHAR(150),\
    awarding_body  VARCHAR(150),\
    award_year     YEAR,\
    award_category VARCHAR(20),\
    company_id     INT,\
    citation       TEXT,\
    CONSTRAINT fk_awards_person\
        FOREIGN KEY (person_id) REFERENCES people (person_id),\
    CONSTRAINT fk_awards_company\
        FOREIGN KEY (company_id) REFERENCES companies (company_id)\
);\
\
-- 11. community_service: advisory and volunteer roles\
--     end_year is NULL while the service continues\
CREATE TABLE community_service (\
    service_id   INT AUTO_INCREMENT PRIMARY KEY,\
    person_id    INT,\
    organisation VARCHAR(150),\
    service_role VARCHAR(100),\
    start_year   YEAR,\
    end_year     YEAR,\
    description  TEXT,\
    CONSTRAINT fk_community_service_person\
        FOREIGN KEY (person_id) REFERENCES people (person_id)\
);\
\
-- 12. interests: life beyond work\
CREATE TABLE interests (\
    interest_id       INT AUTO_INCREMENT PRIMARY KEY,\
    person_id         INT,\
    interest_category VARCHAR(50),\
    description       TEXT,\
    CONSTRAINT fk_interests_person\
        FOREIGN KEY (person_id) REFERENCES people (person_id)\
);\
\
-- 13. achievements: measurable outcomes, linked to a role\
--     and optionally to a project\
CREATE TABLE achievements (\
    achievement_id INT AUTO_INCREMENT PRIMARY KEY,\
    role_id        INT,\
    project_id     INT,\
    measure        VARCHAR(150),\
    value_before   DECIMAL(14,2),\
    value_after    DECIMAL(14,2),\
    unit           VARCHAR(30),\
    CONSTRAINT fk_achievements_role\
        FOREIGN KEY (role_id) REFERENCES roles (role_id),\
    CONSTRAINT fk_achievements_project\
        FOREIGN KEY (project_id) REFERENCES projects (project_id)\
);\
\
-- ---------------------------------------------------------------------\
-- Check the result\
-- ---------------------------------------------------------------------\
SHOW TABLES;          -- expect 13 tables\
DESCRIBE employment;  -- expect person_id and company_id with Key = MUL\
}